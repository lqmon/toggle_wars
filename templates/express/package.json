{
  "name": "flagkit-express-starter",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "NODE_ENV=production node src/server.js",
    "test": "node --test",
    "flags:sync": "flagkit codegen --out src/flags.generated.js",
    "flags:lint": "flagkit lint --flags-file src/flags.generated.js"
  },
  "dependencies": {
    "@flagsmith/nodejs": "^9.5.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "flagsmith-kit": "^0.4.0"
  }
}
