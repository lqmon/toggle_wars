{
  "name": "flagkit",
  "version": "0.1.0",
  "description": "Self-hosted Flagsmith + Experimentation in one command: zero-click bootstrap, a terminal dashboard, a sample A/B test and an agent skill.",
  "type": "module",
  "bin": {
    "flagkit": "bin/flagkit.js"
  },
  "files": [
    "bin",
    "src",
    "stack",
    "demo-app",
    "skills"
  ],
