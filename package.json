    "tui": "node bin/flagkit.js tui"
  },
  "license": "MIT",
  "keywords": [
    "flagsmith",
    "feature-flags",
    "experimentation",
    "ab-testing",
    "self-hosted",
    "tui"
  ],
  "dependencies": {
    "@flagsmith/flagsmith": "^12.6.0",
    "@flagsmith/nodejs": "^9.5.0",
    "ink": "^5.2.1",
    "react": "^18.3.1"
  }
}
